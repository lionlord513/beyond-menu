{
  "Id": "beyondmenu",
  "Name": "BeyondMenu",
  "Version": "0.1.0",
  "Channel": "stable",
  "Description": "An independent F8 menu with item and car catalogs, player tools and custom colors.",
  "Changelog": "First public BeyondMenu build.",
  "Dependencies": ["UE4SS"],
  "LoadAfter": ["BeyondApocalypse", "BeyondTuning"],
  "Preserve": [
    "DriveBeyondHorizons/Binaries/Win64/ue4ss/Mods/BeyondMenu/settings.ini",
    "DriveBeyondHorizons/Binaries/Win64/ue4ss/Mods/BeyondMenu/state"
  ],
  "Update": {
    "Provider": "github",
    "Repository": "lionlord513/beyond-menu",
    "TagPrefix": "v",
    "AssetPattern": "BeyondMenu-{version}-Nexus.zip",
    "ManifestAsset": "bmm-mod.json",
    "Sha256Asset": "SHA256SUMS.txt",
    "Kind": "mod"
  }
}
